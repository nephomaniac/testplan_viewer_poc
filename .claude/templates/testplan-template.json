        "common_beginner_mistakes": [
          {
            "mistake": "Forgetting to set KUBECONFIG environment variable",
            "consequence": "oc commands fail with 'unable to connect to cluster'",
            "how_to_avoid": "Always verify KUBECONFIG is set before running oc commands: echo $KUBECONFIG"
          }
        ]
      },
      "test_execution": {
        "objective": "Verify that the test environment is properly configured and all prerequisites are met",
        "duration": "30 minutes",
        "dependencies": [],
        "prerequisites": [
          "KUBECONFIG set",
          "oc CLI installed"
        ],
        "steps": [
          {
            "step_number": 1,
            "title": "Verify cluster authentication",
            "learning_note": "Authentication is the first step in any cluster operation",
            "command": "oc whoami",
            "expected_output": "system:admin",
            "why_this_step": "Ensures you have proper credentials to interact with the cluster. Without authentication, all subsequent commands will fail.",
            "documentation_reference": "https://docs.openshift.com/container-platform/latest/cli_reference/openshift_cli/getting-started-cli.html",
            "common_errors": [
              {
                "error": "error: You must be logged in to the server (Unauthorized)",
                "solution": "Run: oc login https://api.cluster.example.com:6443",
                "learn_more": "https://docs.openshift.com/container-platform/latest/cli_reference/openshift_cli/getting-started-cli.html#cli-logging-in_cli-developer-commands"
              }
            ]
          },
          {
            "step_number": 2,
            "title": "Check cluster version",
            "learning_note": "Different OpenShift versions have different features and APIs",
            "command": "oc version",
            "expected_output": "Server Version: 4.15.1",
            "why_this_step": "Knowing the cluster version helps you understand which features are available and which documentation to reference",
            "common_errors": []
          }
        ],
        "validation": {
          "success_criteria": [
            "oc whoami returns authenticated username",
            "oc version shows cluster version 4.x",
            "No error messages in any command output"
          ],
          "how_to_verify": "Run: oc whoami && oc version",
          "what_success_means": "Your local environment is properly configured and authenticated to the cluster",
          "what_failure_means": "There's an issue with credentials, network connectivity, or cluster availability"
        }
      },
      "troubleshooting": {
        "common_failures": [
          {
            "symptom": "oc commands timeout or hang",
            "cause": "Network connectivity issue or cluster is down",
            "debug_steps": [
