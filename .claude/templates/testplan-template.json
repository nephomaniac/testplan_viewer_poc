  "concepts": {
    "concept_1": {
      "title": "Kubernetes Pod",
      "description": "A Pod is the smallest deployable unit in Kubernetes. It represents a single instance of a running process in your cluster and can contain one or more containers that share storage and network resources.",
      "why_it_matters": "Understanding Pods is fundamental to working with Kubernetes. All applications run in Pods, and knowing how they work is essential for deployment, debugging, and scaling.",
      "diagram_url": "https://kubernetes.io/images/docs/pod.svg",
      "related_tests": [
        "test_1",
        "test_2"
      ],
      "learn_more": [
        "https://kubernetes.io/docs/concepts/workloads/pods/",
        "https://www.youtube.com/watch?v=5cNrTU6o3Fw"
      ]
    },
    "concept_2": {
      "title": "ServiceMonitor",
      "description": "A ServiceMonitor is a custom resource that declaratively specifies how Prometheus should monitor Kubernetes services. It uses label selectors to find services and defines scrape configuration.",
      "why_it_matters": "ServiceMonitors enable GitOps-friendly monitoring configuration. Instead of manually editing Prometheus config, you create ServiceMonitor resources that automatically configure metric collection.",
      "diagram_url": null,
      "diagram_description": "ServiceMonitor (CRD) → Prometheus Operator (watches) → Prometheus Server (scrapes) → Application Pods (metrics)",
      "related_tests": [
        "test_3"
      ],
      "learn_more": [
        "https://prometheus-operator.dev/docs/operator/design/#servicemonitor"
      ]
    }
  },
