# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
testplan-viewer
testplan-viewer.exe

# Build and dist directories (keep structure via .gitkeep)
build/*
!build/.gitkeep
dist/*
!dist/.gitkeep

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Go workspace file
go.work

# Dependency directories (remove if vendoring)
vendor/

# Generated files
testplan.html

# Exclude generated HTML, but keep template and examples
*.html
!internal/generator/templates/*.html
!examples/**/*.html

# macOS
.DS_Store

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
/tmp/
*.tmp
*.log

# Environment files
.env
.env.local
